# AF Foundation — local development environment.
# Copy to `.env` before running `docker compose up`. Never commit the real .env file.

# --- PostgreSQL -------------------------------------------------------------
# Local-only defaults; change the password for anything longer-lived.
POSTGRES_USER=aff
POSTGRES_PASSWORD=aff_dev_password
POSTGRES_DB=aff_blood
# Host port exposed on your machine (5432 often collides with local Postgres installs).
POSTGRES_HOST_PORT=5433

# --- API / Worker -----------------------------------------------------------
# REQUIRED: generate with e.g. `openssl rand -hex 32` (must be >= 32 chars).
JWT_KEY=replace-me-generate-with-openssl-rand-hex-32
JWT_ISSUER=af-foundation
JWT_AUDIENCE=af-foundation-clients

# Comma-separated origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://localhost:5173

# One-time bootstrap: while set, a caller presenting this exact key to
# POST /api/v1/admin/bootstrap is promoted to the administrator role.
# Leave empty in production after the first admin exists.
ADMIN_BOOTSTRAP_KEY=

# OneSignal push notifications. Leave empty to run with the local no-op
# dispatcher (push is logged, not sent; in-app notification history still works).
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Matching wave radii, km, comma-separated (25 km first, then expansion steps).
MATCHING_RADII_KM=25,50,100

# --- Host ports -------------------------------------------------------------
API_HOST_PORT=8080
WEB_HOST_PORT=4173

# --- Website ----------------------------------------------------------------
# Base URL the landing site uses for deep links to the API (baked at build time).
VITE_API_BASE_URL=http://localhost:8080/api/v1
